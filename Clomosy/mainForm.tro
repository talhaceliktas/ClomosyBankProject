// Prosedurler
void uygulamaKapat;
{
  Unit1 = TclUnit.Create;
  Unit1.UnitName = 'cikisSorguForm';
  Unit1.CallerForm = mainForm;
  Unit1.Run;
  // mainForm.Close();
}
void dovizBilgileriniGuncelle;
var
queryDovizGuncelle : String;
dovizGuncelleJsonQuerysi : TCLJSONQuery;
clRestDovizGuncelle : TCLRest;

dovizHesapIBAN1, dovizHesapIBAN2, dovizTlBakiye1, dovizTlBakiye2, dovizAltinGram1, dovizAltinGram2, dovizDolarBakiye1, dovizDolarBakiye2 : String;
dovizEuroBakiye1, dovizEuroBakiye2, dovizSterlinBakiye1, dovizSterlinBakiye2 : String;

{
    clRestDovizGuncelle=TCLRest.Create; 
     clRestDovizGuncelle.BaseURL = 'https://clomosybankproject.onrender.com/api/musteriler/tum-varliklar'; 
     clRestDovizGuncelle.Accept = 'application/json'; 
     clRestDovizGuncelle.Method = rmPOST;
     queryDovizGuncelle = '{"tcKimlik": "' + tcKimlik +'"}';
     clRestDovizGuncelle.AddBody(queryDovizGuncelle, 'application/json'); 
     clRestDovizGuncelle.Execute;
    try
      dovizGuncelleJsonQuerysi = TCLJSONQuery.Create(nil);  
      dovizGuncelleJsonQuerysi = Clomosy.ClDataSetFromJSON('[' + clRestDovizGuncelle.Response +']');  
      with dovizGuncelleJsonQuerysi do
      {
        if (Found) 
        {
          First; 
          while (not EOF)  
          {
           dovizHesapIBAN1 = FieldByName('iban1').AsString;
           dovizHesapIBAN2 = FieldByName('iban2').AsString;
           dovizTlBakiye1 = FieldByName('tlbakiye1').AsString;
           dovizTlBakiye2 = FieldByName('tlbakiye2').AsString;
           dovizAltinGram1 = FieldByName('altinGram1').AsString;
           dovizAltinGram2 = FieldByName('altinGram2').AsString;
           dovizDolarBakiye1 = FieldByName('dolarUSD1').AsString;
           dovizDolarBakiye2 = FieldByName('dolarUSD2').AsString;
           dovizEuroBakiye1 = FieldByName('euroEUR1').AsString;
           dovizEuroBakiye2 = FieldByName('euroEUR2').AsString;
           dovizSterlinBakiye1 = FieldByName('sterlinGBP1').AsString;
           dovizSterlinBakiye2 = FieldByName('sterlinGBP2').AsString;

           Next;
          }
          altinMikDovizLbl1.Text = 'Altin: ' + dovizAltinGram1 + 'g';
          dolarMikDovizLbl1.Text = 'Dolar: ' + dovizDolarBakiye1 + '$';
          euroMikDovizLbl1.Text = 'Euro: ' + dovizEuroBakiye1 + '€';
          sterlinMikDovizLbl1.Text = 'Sterlin: ' + dovizSterlinBakiye1 + '£';
          altinMikDovizLbl2.Text = 'Altin: ' + dovizAltinGram2 + 'g';
          dolarMikDovizLbl2.Text = 'Dolar: ' + dovizDolarBakiye2 + '$';
          euroMikDovizLbl2.Text = 'Euro: ' + dovizEuroBakiye2 + '€';
          sterlinMikDovizLbl2.Text = 'Sterlin: ' + dovizSterlinBakiye2 + '£';
          vadesizHesapNoDovizLbl1.Text ='IBAN: TR' + dovizHesapIBAN1;
          vadesizHesapNoDovizLbl2.Text ='IBAN: TR' + dovizHesapIBAN2;
          kullanilabilirDovizBakiye1.Text = dovizTlBakiye1 + 'TL';
          kullanilabilirDovizBakiye2.Text = dovizTlBakiye2 + 'TL';
          
        }
        
      }
    except
      
      ShowMessage('Exception Class: '+LastExceptionClassName+' Exception Message: '+LastExceptionMessage);
    }
}
void dovizAl;
var
queryDovizAl : String;
dovizAlJsonQuerysi : TCLJSONQuery;
clRestDovizAl : TCLRest;
secilenKrediKartiDoviz, secilenDovizTuru: Integer

{
  secilenKrediKartiDoviz = radioGrupDoviz1.ItemIndex + 1;
  secilenDovizTuru = radioGrupDoviz.ItemIndex + 1;
    clRestDovizAl=TCLRest.Create; 

     clRestDovizAl.BaseURL = 'https://clomosybankproject.onrender.com/api/musteriler/satin-al'; 
     clRestDovizAl.Accept = 'application/json'; 
     clRestDovizAl.Method = rmPOST;
    
     
     queryDovizAl = '{"TCKimlik": "' + tcKimlik +'", "kart":"' + IntToStr(secilenKrediKartiDoviz) +'","yatirilanTL":"' + dovizAlAdetiEdt.Text +'", "alinanTip":"' + IntToStr(secilenDovizTuru) + '"}';

     clRestDovizAl.AddBody(queryDovizAl, 'application/json'); 
     clRestDovizAl.Execute;
     
    try
      dovizAlJsonQuerysi = TCLJSONQuery.Create(nil);  
      dovizAlJsonQuerysi = Clomosy.ClDataSetFromJSON('[' + clRestDovizAl.Response +']');  
      with dovizAlJsonQuerysi do
      {
        if (Found) 
        {
          First; 
          while (not EOF)  
          {
           ShowMessage(FieldByName('message').AsString);
           Next;
          }
        }
        dovizBilgileriniGuncelle();
      }
    except
      
      ShowMessage('Exception Class: '+LastExceptionClassName+' Exception Message: '+LastExceptionMessage);
    }
}

