     clRestOdemeYap.AddBody(queryOdemeYap, 'application/json'); 
     clRestOdemeYap.Execute;
     
    try
      OdemeYapJsonQuerysi = TCLJSONQuery.Create(nil);  
      OdemeYapJsonQuerysi = Clomosy.ClDataSetFromJSON('[' + clRestOdemeYap.Response +']');  
      with OdemeYapJsonQuerysi do
      {
        if (Found) 
        {
          First; 
          while (not EOF)  
          {
           ShowMessage(FieldByName('message').AsString);
           Next;
          }
        }
        odemelerForm();
      }
    except
      
      ShowMessage('Exception Class: '+LastExceptionClassName+' Exception Message: '+LastExceptionMessage);
    }

}


void transferForm;
var
tranferHesapNo1, tranferHesapNo2, transferKullanilabilirBakiye1, transferKullanilabilirBakiye2: String;
queryTransfer : String;
transferJsonQuerysi : TCLJSONQuery;
clRestTransfer : TCLRest;
{
  hesaplarPanel.Width = 0;
  hesaplarPanel.Height = 0;
  kredilerPanel.Width = 0;
  kredilerPanel.Width = 0;
  kartlarPanel.Width = 0;
  kartlarPanel.Height = 0;
  dovizPanel.Height = 0;
  dovizPanel.Width = 0;
  transferPanel.Height = 700;
  transferPanel.Width = 700;
  
  if(mainForm.clWidth < 400){
  transferPanel.Height = 430;
  transferPanel.Width = 330;
  transferPanel.Margins.Bottom = 230;
  }
  

  odemelerPanel.Width = 0;
  odemelerPanel.Width = 0;
  
    clRestTransfer=TCLRest.Create; 
     // Post 
    
     
     clRestTransfer.BaseURL = 'https://clomosybankproject.onrender.com/api/musteriler/kullanici-iban-bakiye'; 
     clRestTransfer.Accept = 'application/json'; 
     clRestTransfer.Method = rmPOST;
    
     
     queryTransfer = '{"tcKimlik": "' + tcKimlik +'"}';

     clRestTransfer.AddBody(queryTransfer, 'application/json'); 
     clRestTransfer.Execute;
     
    try
      transferJsonQuerysi = TCLJSONQuery.Create(nil);  
      transferJsonQuerysi = Clomosy.ClDataSetFromJSON('[' + clRestTransfer.Response +']');  
      with transferJsonQuerysi do
      {
        if (Found) 
        {
          First; 
          while (not EOF)  
          {
            tranferHesapNo1 = FieldByName('iban1').AsString;
            tranferHesapNo2 = FieldByName('iban2').AsString;
            transferKullanilabilirBakiye1 =  FieldByName('bakiye1').AsString;
            transferKullanilabilirBakiye2 =  FieldByName('bakiye2').AsString;
            Next;
          }
          vadesizHesapNoTranferLbl1.Text = 'IBAN: TR' + tranferHesapNo1;
          kullanilabilirTransferBakiye1.Text = transferKullanilabilirBakiye1 + 'TL';
          
          vadesizHesapNoTranferLbl2.Text = 'IBAN: TR' + tranferHesapNo2;
          kullanilabilirTransferBakiye2.Text = transferKullanilabilirBakiye2 + 'TL';
        }
        
      }
    except
      
      ShowMessage('Exception Class: '+LastExceptionClassName+' Exception Message: '+LastExceptionMessage);
    }
  
}





void ibanaGonder;
var
gonderenIBAN: String;
queryTransferAktarim : String;
TransferAktarimJsonQuerysi : TCLJSONQuery;
clRestTransferAktarim : TCLRest;
{
  if(krediKarti1RdBtn.IsChecked || krediKarti2RdBtn.IsChecked){
    
    if(krediKarti1RdBtn.IsChecked){
      gonderenIBAN = vadesizHesapNoTranferLbl1.Text;
    }
    else
    {
      gonderenIBAN = vadesizHesapNoTranferLbl2.Text;
    }
    Delete(gonderenIBAN,1, 8);
      clRestTransferAktarim=TCLRest.Create; 
     // Post 
    
     
     clRestTransferAktarim.BaseURL = 'https://clomosybankproject.onrender.com/api/musteriler/iban-transfer'; 
     clRestTransferAktarim.Accept = 'application/json'; 
     clRestTransferAktarim.Method = rmPOST;
    
     
     queryTransferAktarim = '{"gonderenIBAN": "' + gonderenIBAN +'", "aliciIBAN":"' + ibanEdit.Text +'", "miktar":"' + gonderilecekEdit.Text + '"}';

     clRestTransferAktarim.AddBody(queryTransferAktarim, 'application/json'); 
     clRestTransferAktarim.Execute;
     
    try
      TransferAktarimJsonQuerysi = TCLJSONQuery.Create(nil);  
      TransferAktarimJsonQuerysi = Clomosy.ClDataSetFromJSON('[' + clRestTransferAktarim.Response +']');  
      with TransferAktarimJsonQuerysi do
      {
        if (Found) 
        {
          First; 
          while (not EOF)  
          {
            ShowMessage(FieldByName('message').AsString);
            Next;
          }
        }
        transferForm();
      }
    except
      
      ShowMessage('Exception Class: '+LastExceptionClassName+' Exception Message: '+LastExceptionMessage);
    }
  
    
  }
  else
  {
    ShowMessage('Lutfen Kart Secimi Yapiniz!');
  }
}



void kartlarForm;
var
krediHesapNo1, krediHesapNo2, krediKullanilabilirBakiye1, krediKullanilabilirBakiye2, krediSahipIsim, krediSahipSoyisim: String;
krediBorcMiktari1,krediBorcMiktari2 : String;
queryKartlar : String;
kartlarJsonQuerysi : TCLJSONQuery;
clRestKartlar : TCLRest;
{
  hesaplarPanel.Width = 0;
  hesaplarPanel.Height = 0;
  transferPanel.Width = 0;
  transferPanel.Width = 0;
  odemelerPanel.Width = 0;
  odemelerPanel.Width = 0;
  kredilerPanel.Width = 0;
  kredilerPanel.Width = 0;
  dovizPanel.Height = 0;
  dovizPanel.Width = 0;
  
  if (mainForm.clWidth < 400){
  kartlarPanel.Width = 300;
  kartlarPanel.Height = 200;
  }
  else{
  kartlarPanel.Width = 800;
  kartlarPanel.Height = 800;
  }
  clRestKartlar=TCLRest.Create; 

     clRestKartlar.BaseURL = 'https://clomosybankproject.onrender.com/api/musteriler/kredi-bilgileri'; 
     clRestKartlar.Accept = 'application/json'; 
     clRestKartlar.Method = rmPOST;
    
     
     queryKartlar = '{"tcKimlik": "' + tcKimlik +'"}';

     clRestKartlar.AddBody(queryKartlar, 'application/json'); 
     clRestKartlar.Execute;
     
    try
      kartlarJsonQuerysi = TCLJSONQuery.Create(nil);  
      kartlarJsonQuerysi = Clomosy.ClDataSetFromJSON('[' + clRestKartlar.Response +']');  
      with kartlarJsonQuerysi do
      {
        if (Found) 
        {
          First; 
          while (not EOF)  
          {
            krediHesapNo1 = FieldByName('kartID1').AsString;
            krediHesapNo2 = FieldByName('kartID2').AsString;
            krediKullanilabilirBakiye1 =  FieldByName('kartLim1').AsString;
            krediKullanilabilirBakiye2 =  FieldByName('kartLim2').AsString;
            krediBorcMiktari1 =  FieldByName('borcMik1').AsString;
            krediBorcMiktari2 =  FieldByName('borcMik2').AsString;
            krediSahipIsim =  FieldByName('isim').AsString;
            krediSahipSoyisim =  FieldByName('soyIsim').AsString;
            Next;
          }
            krediIsimLbl1.Text = krediSahipIsim + ' ' + krediSahipSoyisim; 
            krediIsimLbl2.Text = krediSahipIsim + ' ' + krediSahipSoyisim; 
            
            krediHesapNoLbl1.Text = 'Hesap No: ' + krediHesapNo1;
            krediHesapNoLbl2.Text = 'Hesap No: ' + krediHesapNo2;
            
            kullanilabilirKrediBakiye1.Text = krediKullanilabilirBakiye1 + 'TL';
            kullanilabilirKrediBakiye2.Text = krediKullanilabilirBakiye2 + 'TL';
            
            krediBorcBakiye1.Text = krediBorcMiktari1 + 'TL';
            krediBorcBakiye2.Text = krediBorcMiktari2 + 'TL';
        }
      }
    except
      
      ShowMessage('Exception Class: '+LastExceptionClassName+' Exception Message: '+LastExceptionMessage);
    }
  
}





void hesaplarForm;
var
hesapNo1, hesapNo2, isim, soyIsim, iban1, iban2 : String;
kullanilabilirBakiyeTutar1, kullanilabilirBakiyeTutar2, dolarMik1, euroMik1, SterlinMik1, altinMik1, dolarMik2, euroMik2, SterlinMik2, altinMik2 : Float;

query : String;
hesaplarJsonQuerysi : TCLJSONQuery;
clRestHesaplar : TCLRest;
{
  transferPanel.Width = 0;
  transferPanel.Width = 0;
  kartlarPanel.Width = 0;
  kartlarPanel.Height = 0;
  odemelerPanel.Width = 0;
  odemelerPanel.Width = 0;
  kredilerPanel.Width = 0;
  kredilerPanel.Width = 0;
  dovizPanel.Height = 0;
  dovizPanel.Width = 0;
  
  if (mainForm.clWidth < 400){
  hesaplarPanel.Width = 300;
  hesaplarPanel.Height = 200;
  }
  else{
  hesaplarPanel.Width = 800;
  hesaplarPanel.Height = 800;
  }
    clRestHesaplar=TCLRest.Create; 
     clRestHesaplar.BaseURL = 'https://clomosybankproject.onrender.com/api/musteriler/hesap-bilgileri'; 
     clRestHesaplar.Accept = 'application/json'; 
     clRestHesaplar.Method = rmPOST;
    
     
     query = '{"tcKimlik": "' + tcKimlik +'"}';

     clRestHesaplar.AddBody(query, 'application/json'); 
     clRestHesaplar.Execute;
     
    try
      hesaplarJsonQuerysi = TCLJSONQuery.Create(nil);  
      hesaplarJsonQuerysi = Clomosy.ClDataSetFromJSON('[' + clRestHesaplar.Response +']');  
      with hesaplarJsonQuerysi do
      {
        if (Found) 
        {
          First; 
          while (not EOF)  
          {
            isim = FieldByName('isim').AsString;
            soyIsim = FieldByName('soyIsim').AsString;
            hesapNo1 = FieldByName('hesapNo1').AsString;
            iban1 = FieldByName('iban1').AsString;
            kullanilabilirBakiyeTutar1 = FieldByName('kullanilabilirBakiyeTutar1').AsString;
            dolarMik1 = FieldByName('dolarMik1').AsString;
            euroMik1 = FieldByName('euroMik1').AsString;
            SterlinMik1 = FieldByName('SterlinMik1').AsString;
            altinMik1 = FieldByName('altinMik1').AsString;
            hesapNo2 = FieldByName('hesapNo2').AsString;
            iban2 = FieldByName('iban2').AsString;
            kullanilabilirBakiyeTutar2 = FieldByName('kullanilabilirBakiyeTutar2').AsString;
            dolarMik2 = FieldByName('dolarMik2').AsString;
            euroMik2 = FieldByName('euroMik2').AsString;
            SterlinMik2 = FieldByName('SterlinMik2').AsString;
            altinMik2 = FieldByName('altinMik2').AsString;
            
            Next;
          }
        }
        vadesizHesapNoLbl1.Text = 'Hesap No: ' + hesapNo1;
        vadesizHesapNoLbl2.Text = 'Hesap No: ' + hesapNo2;
        
        vadesizIsimLbl1.Text = isim + ' ' + soyIsim;
        vadesizIsimLbl2.Text = isim + ' ' + soyIsim;
        
        kullanilabilirBankaBakiye1.Text = kullanilabilirBakiyeTutar1 + 'TL';
        kullanilabilirBankaBakiye2.Text = kullanilabilirBakiyeTutar2 + 'TL';
        
        ibanLbl1.Text = 'IBAN: TR' + iban1;
        ibanLbl2.Text = 'IBAN: TR' + iban2;
        euroBnkLbl1.Text = 'Euro: ' + euroMik1 + '€';
        euroBnkLbl2.Text = 'Euro: ' + euroMik2 + '€';
        dolarBnkLbl1.Text = 'Dolar: ' + dolarMik1 + '$';
        dolarBnkLbl2.Text = 'Dolar: ' + dolarMik2 + '$';
        altinBnkLbl1.Text = 'Altin: ' + altinMik1 + 'g';
        altinBnkLbl2.Text = 'Altin: ' + altinMik2 + 'g';
        sterlinBnkLbl1.Text = 'Sterlin: ' + SterlinMik1 + '£';
        sterlinBnkLbl2.Text = 'Sterlin: ' + SterlinMik2 + '£';
      }
    except
      
      ShowMessage('Exception Class: '+LastExceptionClassName+' Exception Message: '+LastExceptionMessage);
    }


}

