void dovizForm;
{

  dovizPanel.Width = 860;
  dovizPanel.Height = 820;
  
  if(mainForm.clWidth < 400){
    dovizPanel.Width = 320;
    dovizPanel.Height = 460;
    dovizPanel.Margins.Bottom = 250
  }
  
  kredilerPanel.Width = 0;
  kredilerPanel.Width = 0;
  odemelerPanel.Width = 0;
  odemelerPanel.Width = 0;
  transferPanel.Width = 0;
  transferPanel.Width = 0;
  kartlarPanel.Width = 0;
  kartlarPanel.Height = 0;
  hesaplarPanel.Width = 0;
  hesaplarPanel.Height = 0;
  dovizBilgileriniGuncelle();
}

void alimBasildi;
{
  dovizAlimSatimPanel.Visible = True;
  dovizAlAdetiEdt.Visible = True;
  dovizSatAdetiEdt.Visible = False;
  dovizAlBtn.Visible = True;
  dovizSatBtn.Visible = False;
}

void satimBasildi;
{
  dovizAlimSatimPanel.Visible = True;
  dovizAlAdetiEdt.Visible = False;
  dovizSatAdetiEdt.Visible = True;
  dovizAlBtn.Visible = False;
  dovizSatBtn.Visible = True;
}







void kredilerForm
var
queryKrediler : String;
kredilerJsonQuerysi : TCLJSONQuery;
clRestKrediler : TCLRest;

krediKartLimitKrediler1, krediKartLimitKrediler2, bankaKartiBakiyeKrediler1, bankaKartiBakiyeKrediler2, hesapNoKrediler1, hesapNoKrediler2 : String;
{
  kredilerPanel.Width = 1000;
  kredilerPanel.Width = 700;

  if(mainForm.clWidth < 400){
    kredilerPanel.Width = 320;
    kredilerPanel.Height = 460;
  }

  odemelerPanel.Width = 0;
  odemelerPanel.Width = 0;
  transferPanel.Width = 0;
  transferPanel.Width = 0;
  kartlarPanel.Width = 0;
  kartlarPanel.Height = 0;
  hesaplarPanel.Width = 0;
  hesaplarPanel.Height = 0;
  dovizPanel.Height = 0;
  dovizPanel.Width = 0;
  
  
     clRestKrediler=TCLRest.Create; 
     // Post 
    
     
     clRestKrediler.BaseURL = 'https://clomosybankproject.onrender.com/api/musteriler/kredi-ve-banka-limiti-ve-bakiye'; 
     clRestKrediler.Accept = 'application/json'; 
     clRestKrediler.Method = rmPOST;
    
     
     queryKrediler = '{"tcKimlik": "' + tcKimlik +'"}';

     clRestKrediler.AddBody(queryKrediler, 'application/json'); 
     clRestKrediler.Execute;
     
    try
      kredilerJsonQuerysi = TCLJSONQuery.Create(nil);  
      kredilerJsonQuerysi = Clomosy.ClDataSetFromJSON('[' + clRestKrediler.Response +']');  
      with kredilerJsonQuerysi do
      {
        if (Found) 
        {
          First; 
          while (not EOF)  
          {
           krediKartLimitKrediler1 = FieldByName('krediKartLimit1').AsString;
           krediKartLimitKrediler2 = FieldByName('krediKartLimit2').AsString;
           hesapNoKrediler1 = FieldByName('bankaIban1').AsString;
           hesapNoKrediler2 = FieldByName('bankaIban2').AsString;
           bankaKartiBakiyeKrediler1 = FieldByName('bankaBakiye1').AsString;
           bankaKartiBakiyeKrediler2 = FieldByName('bankaBakiye2').AsString;
           Next;
          }
          kullanilabilirKredilerBakiye1.Text = bankaKartiBakiyeKrediler1 + 'TL';
          kullanilabilirKredilerBakiye2.Text = bankaKartiBakiyeKrediler2 + 'TL';
          krediKartiLimitKrediler1.Text = krediKartLimitKrediler1 + 'TL';
          krediKartiLimitKrediler2.Text = krediKartLimitKrediler2 + 'TL';
          vadesizHesapNoKredilerLbl1.Text = 'Hesap No: ' + hesapNoKrediler1;
          vadesizHesapNoKredilerLbl2.Text = 'Hesap No: ' + hesapNoKrediler2;
        }
        
      }
    except
      
      ShowMessage('Exception Class: '+LastExceptionClassName+' Exception Message: '+LastExceptionMessage);
    }
  
}


void KrediCek;
var
queryKrediCek : String;
krediCekJsonQuerysi : TCLJSONQuery;
clRestKrediCek : TCLRest;
secilenKrediKartiKrediler, secilenBankaKartiKrediler : Integer
{

  secilenBankaKartiKrediler = radioGrupKrediler1.ItemIndex + 1;
  secilenKrediKartiKrediler = radioGrupKrediler2.ItemIndex + 1;
    clRestKrediCek=TCLRest.Create; 
     clRestKrediCek.BaseURL = 'https://clomosybankproject.onrender.com/api/musteriler/kredi-cek'; 
     clRestKrediCek.Accept = 'application/json'; 
     clRestKrediCek.Method = rmPOST;
    
     
     queryKrediCek = '{"tcKimlik": "' + tcKimlik +'", "krediKartiSecimi":"' + IntToStr(secilenKrediKartiKrediler) +'","bankaKartiSecimi":"' + IntToStr(secilenBankaKartiKrediler) +'", "cekilecekTutar":"' + krediTutariEdt.Text + '"}';

     clRestKrediCek.AddBody(queryKrediCek, 'application/json'); 
     clRestKrediCek.Execute;
     
    try
      krediCekJsonQuerysi = TCLJSONQuery.Create(nil);  
      krediCekJsonQuerysi = Clomosy.ClDataSetFromJSON('[' + clRestKrediCek.Response +']');  
      with krediCekJsonQuerysi do
      {
        if (Found) 
        {
          First; 
          while (not EOF)  
          {
           ShowMessage(FieldByName('message').AsString);
           Next;
          }
        }
        kredilerForm();
      }
    except
      
      ShowMessage('Exception Class: '+LastExceptionClassName+' Exception Message: '+LastExceptionMessage);
    }
}



void odemelerForm;
var
queryOdemeler : String;
odemelerJsonQuerysi : TCLJSONQuery;
clRestOdemeler : TCLRest;


odemelerKalanBorc1, odemelerKalanBorc2, odemelerIban1, odemelerIban2,  odemelerBnkBakiy1,  odemelerBnkBakiy2 : String;

{
  odemelerPanel.Height = 700;
  odemelerPanel.Width = 700;
  
  if(mainForm.clWidth < 400){
    odemelerPanel.Height = 460;
    odemelerPanel.Width = 320;
    odemelerPanel.Margins.Bottom = 240;
  }
  
  transferPanel.Width = 0;
  transferPanel.Width = 0;
  kartlarPanel.Width = 0;
  kartlarPanel.Height = 0;
  hesaplarPanel.Width = 0;
  hesaplarPanel.Height = 0;
  kredilerPanel.Width = 0;
  kredilerPanel.Width = 0;
  dovizPanel.Height = 0;
  dovizPanel.Width = 0;
  
  
  
   clRestOdemeler=TCLRest.Create; 
     // Post 
    
     
     clRestOdemeler.BaseURL = 'https://clomosybankproject.onrender.com/api/musteriler/kredi-ve-banka-ozeti'; 
     clRestOdemeler.Accept = 'application/json'; 
     clRestOdemeler.Method = rmPOST;
    
     
     queryOdemeler = '{"tcKimlik": "' + tcKimlik +'"}';

     clRestOdemeler.AddBody(queryOdemeler, 'application/json'); 
     clRestOdemeler.Execute;
     
    try
      odemelerJsonQuerysi = TCLJSONQuery.Create(nil);  
      odemelerJsonQuerysi = Clomosy.ClDataSetFromJSON('[' + clRestOdemeler.Response +']');  
      with odemelerJsonQuerysi do
      {
        if (Found) 
        {
          First; 
          while (not EOF)  
          {
           odemelerKalanBorc1 = FieldByName('borc1').AsString;
           odemelerKalanBorc2 = FieldByName('borc2').AsString;
           odemelerIban1 = FieldByName('iban1').AsString;
           odemelerIban2 = FieldByName('iban2').AsString;
           odemelerBnkBakiy1 = FieldByName('bakiye1').AsString;
           odemelerBnkBakiy2 = FieldByName('bakiye2').AsString;
           Next;
          }
          kalanBorcBilgisiOdemeler1.Text = odemelerKalanBorc1 + 'TL';
          kalanBorcBilgisiOdemeler2.Text = odemelerKalanBorc2 + 'TL';
          kullanilabilirOdemelerBakiye1.Text = odemelerBnkBakiy1 + 'TL';
          kullanilabilirOdemelerBakiye2.Text = odemelerBnkBakiy2 + 'TL';
          vadesizHesapNoOdemelerLbl1.Text = 'IBAN: TR' + odemelerIban1;
          vadesizHesapNoOdemelerLbl2.Text = 'IBAN: TR' + odemelerIban2;
        }
        
      }
    except
      
      ShowMessage('Exception Class: '+LastExceptionClassName+' Exception Message: '+LastExceptionMessage);
    }
  
  
}



void odemeYap;
