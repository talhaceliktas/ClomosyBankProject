function setButtonHesaplarBtnMobile(AMyForm,AButton,ACaption):TclProButon;
var
  customButton : TclProButton;
{
  customButton = AMyForm.AddNewProButton(AMyForm, AButton, ACaption);
  clComponent.SetupComponent(customButton,'{"BackgroundColor":"#d9d9d9", 
  "BorderWidth":1, "Height":70, "TextSize":15, "BorderColor":"#a5a5a5"}');
  customButton.Align = alNone
  customButton.Width = AMyForm.clWidth / 6;
  customButton.Position.X = 0
  customButton.Position.Y = AMyForm.clHeight - 250;
  
  Result = customButton;
}


